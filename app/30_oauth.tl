;; Thimble: AT Protocol OAuth (PAR + PKCE + DPoP). All crypto comes from iOS.
(global gNonces gDpopKey gOAuth)
(cfn SecKeyCreateRandomKey id id id)
(cfn SecKeyCopyPublicKey id id)
(cfn SecKeyCopyExternalRepresentation id id id)
(cfn SecKeyCreateSignature id id id id id)
(cfn SecKeyCreateWithData id id id id)
(cfn CC_SHA256 id id int id)

(def savenonce (resp)
  (let n (.valueForHTTPHeaderField: resp "DPoP-Nonce"))
  (if (not gNonces) (set gNonces (new NSMutableDictionary)))
  (if n (.setValue:forKey: gNonces n (.host (.URL resp)))))
(def b64u (d)
  (let s (.base64EncodedStringWithOptions: d 0))
  (let s (.stringByReplacingOccurrencesOfString:withString: s "+" "-"))
  (let s (.stringByReplacingOccurrencesOfString:withString: s "/" "_"))
  (.stringByReplacingOccurrencesOfString:withString: s "=" ""))
(def utf8 (s) (.dataUsingEncoding: s 4))
(def jsonb64 (o) (b64u (.dataWithJSONObject:options:error: NSJSONSerialization o 0 0)))
(def sha256 (d)
  (let out (malloc 32))
  (CC_SHA256 (.bytes d) (.length d) out)
  (.dataWithBytes:length: NSData out 32))
(def uuid () (.UUIDString (.UUID NSUUID)))
(def byteat (p i) (& (peek (+ p i)) 255))
(def rawint (out p n)
  ;; appends a DER integer as exactly 32 big-endian bytes
  (let zeros (malloc 32))
  (memset zeros 0 32)
  (if (> n 32) (.appendBytes:length: out (+ p (- n 32)) 32)
    (do (.appendBytes:length: out zeros (- 32 n)) (.appendBytes:length: out p n))))
(def der2raw (d)
  (let p (.bytes d))
  (let out (.data NSMutableData))
  (let rl (byteat p 3))
  (rawint out (+ p 4) rl)
  (let sl (byteat p (+ 5 rl)))
  (rawint out (+ p (+ 6 rl)) sl)
  out)
(def newkey ()
  (set gDpopKey (SecKeyCreateRandomKey (dict "type" "73" "bsiz" (nsn 256)) 0)))
(def keydata () (SecKeyCopyExternalRepresentation gDpopKey 0))
(def restorekey (b64)
  (let d (.autorelease (.initWithBase64EncodedString:options: (.alloc NSData) b64 0)))
  (set gDpopKey (SecKeyCreateWithData d (dict "type" "73" "kcls" "1" "bsiz" (nsn 256)) 0)))
(def jwk ()
  (let pub (SecKeyCopyExternalRepresentation (SecKeyCopyPublicKey gDpopKey) 0))
  (let p (.bytes pub))
  (dict "kty" "EC" "crv" "P-256"
    "x" (b64u (.dataWithBytes:length: NSData (+ p 1) 32))
    "y" (b64u (.dataWithBytes:length: NSData (+ p 33) 32))))
(def now () (ftoi (.timeIntervalSince1970 (.date NSDate))))
(def proof (verb url tok)
  (let htu (.objectAtIndex: (.componentsSeparatedByString: url "?") 0))
  (let host2 (.host (.URLWithString: NSURL url)))
  (let nonce (if gNonces (.objectForKey: gNonces host2) nil))
  (let head (jsonb64 (dict "typ" "dpop+jwt" "alg" "ES256" "jwk" (jwk))))
  (let body (jsonb64 (dict "htm" verb "htu" htu "iat" (nsn (now)) "jti" (uuid) "nonce" nonce
    "ath" (if tok (b64u (sha256 (utf8 tok))) nil))))
  (let m (str head "." body))
  (let sig (SecKeyCreateSignature gDpopKey "algid:sign:ECDSA:message-X962:SHA256" (utf8 m) 0))
  (str m "." (b64u (der2raw sig))))
(def authorize (r verb url tok)
  (if (at gSession "_as")
    (do
      (if (not gDpopKey) (restorekey (at gSession "_key")))
      (.setValue:forHTTPHeaderField: r (str "DPoP " tok) "Authorization")
      (.setValue:forHTTPHeaderField: r (proof verb url tok) "DPoP"))
    (.setValue:forHTTPHeaderField: r (str "Bearer " tok) "Authorization")))

;; ---- discovery
(def env (k) (.objectForKey: (.environment (.processInfo NSProcessInfo)) k))
(def oscope () "atproto transition:generic transition:chat.bsky")
(def devredirect () "http://127.0.0.1:8123/cb")
(def formenc (s) (.stringByAddingPercentEncodingWithAllowedCharacters: s (.alphanumericCharacterSet NSCharacterSet)))
;; A release client ID is the public URL of the hosted metadata file. It is unset
;; until that file is published, so the browser sign-in button stays hidden.
(def oauthclient ()
  (if (env "THIMBLE_OAUTH_DEV")
    (str "http://localhost?redirect_uri=" (formenc (devredirect)) "&scope=" (formenc (oscope)))
    nil))
(def oredirect () (devredirect))
(def getjson (url done)
  (fetch (.requestWithURL: NSMutableURLRequest (.URLWithString: NSURL url)) done))
(def form (pairs)
  (let i 0)
  (let out "")
  (while (< i (.count pairs))
    (let out (str out (if (> i 0) "&" "") (.objectAtIndex: pairs i) "=" (formenc (.objectAtIndex: pairs (+ i 1)))))
    (let i (+ i 2)))
  (utf8 out))
(def formpost (url pairs done)
  ;; retries once when the server asks for a fresh DPoP nonce
  (let go (new NSMutableArray))
  (let send (block (again)
    (let r (.requestWithURL: NSMutableURLRequest (.URLWithString: NSURL url)))
    (.setHTTPMethod: r "POST")
    (.setValue:forHTTPHeaderField: r "application/x-www-form-urlencoded" "Content-Type")
    (.setValue:forHTTPHeaderField: r (proof "POST" url nil) "DPoP")
    (.setHTTPBody: r (form pairs))
    (fetch r (block (j code)
      (if (and again (.isEqual: (at j "error") "use_dpop_nonce"))
        (invoke (.objectAtIndex: go 0) false)
        (invoke done j code))))))
  (.addObject: go send)
  (invoke send true))
(def oauthstart (vc handle err)
  (.setText: err "")
  (if (not (> (.length handle) 0)) (return (.setText: err "Enter your handle first")))
  (getjson (str "https://bsky.social/xrpc/com.atproto.identity.resolveHandle?handle=" (urlq handle))
    (block (r code)
      (if (not (= code 200)) (return (.setText: err "Handle not found")))
      (let did (at r "did"))
      (getjson (str "https://plc.directory/" did) (block (doc c2)
        (let pds (findpds doc))
        (if (isnull pds) (return (.setText: err "Could not find your server")))
        (getjson (str pds "/.well-known/oauth-protected-resource") (block (pr c3)
          (let as (.objectAtIndex: (at pr "authorization_servers") 0))
          (getjson (str as "/.well-known/oauth-authorization-server") (block (meta c4)
            (par vc handle did pds meta err))))))))))
(def findpds (doc)
  (let svc (at doc "service"))
  (let i 0)
  (while (< i (.count svc))
    (let s (.objectAtIndex: svc i))
    (if (.isEqualToString: (at s "id") "#atproto_pds") (return (at s "serviceEndpoint")))
    (let i (+ i 1)))
  nil)
(def par (vc handle did pds meta err)
  (newkey)
  (let verifier (.stringByReplacingOccurrencesOfString:withString: (str (uuid) (uuid)) "-" ""))
  (let state (uuid))
  (let client (oauthclient))
  (formpost (at meta "pushed_authorization_request_endpoint")
    (list "client_id" client "response_type" "code" "redirect_uri" (oredirect) "scope" (oscope) "state" state
      "code_challenge" (b64u (sha256 (utf8 verifier))) "code_challenge_method" "S256" "login_hint" handle)
    (block (j code)
      (if (not (= code 201)) (return (.setText: err "Sign-in could not start")))
      (let url (str (at meta "authorization_endpoint") "?client_id=" (formenc client) "&request_uri=" (formenc (at j "request_uri"))))
      (let s (.initWithURL:callbackURLScheme:completionHandler: (.alloc ASWebAuthenticationSession) (.URLWithString: NSURL url) "thimble"
        (block (cb e)
          (if cb (redeem vc cb state verifier client did pds handle meta err) (.setText: err "Sign-in cancelled")))))
      (.setPresentationContextProvider: s vc)
      (set gOAuth s)
      (.start s))))
(def query (url name)
  (let items (.queryItems (.componentsWithURL:resolvingAgainstBaseURL: NSURLComponents url false)))
  (let i 0)
  (while (< i (.count items))
    (let q (.objectAtIndex: items i))
    (if (.isEqualToString: (.name q) name) (return (.value q)))
    (let i (+ i 1)))
  nil)
(def redeem (vc cb state verifier client did pds handle meta err)
  (if (not (.isEqual: (query cb "state") state)) (return (.setText: err "Sign-in failed: state mismatch")))
  (let tokurl (at meta "token_endpoint"))
  (formpost tokurl
    (list "grant_type" "authorization_code" "code" (query cb "code") "redirect_uri" (oredirect) "client_id" client "code_verifier" verifier)
    (block (j code)
      (if (or (not (= code 200)) (not (.isEqual: (at j "sub") did)))
        (return (.setText: err "Sign-in failed")))
      (savesession (dict "did" did "handle" handle "accessJwt" (at j "access_token") "refreshJwt" (at j "refresh_token")
        "didDoc" (dict "service" (list (dict "serviceEndpoint" pds)))
        "_as" tokurl "_client" client "_key" (.base64EncodedStringWithOptions: (keydata) 0)))
      (showmain))))
(def oauthrefresh (retry fail)
  (if (not gDpopKey) (restorekey (at gSession "_key")))
  (formpost (at gSession "_as") (list "grant_type" "refresh_token" "refresh_token" (at gSession "refreshJwt") "client_id" (at gSession "_client"))
    (block (j code)
      (if (not (= code 200)) (return (invoke fail nil code)))
      (let s (.dictionaryWithDictionary: NSMutableDictionary gSession))
      (.setValue:forKey: s (at j "access_token") "accessJwt")
      (.setValue:forKey: s (at j "refresh_token") "refreshJwt")
      (savesession s)
      (invoke retry))))
