;; Thimble: core app. Explicit on purpose; sizes come from the compiler.
(global gSession gCache gWindow)

;; ---- helpers
(def font (style) (.preferredFontForTextStyle: UIFont style))
(def label (style color lines)
  (let l (new UILabel))
  (.setFont: l (font style))
  (.setTextColor: l color)
  (.setNumberOfLines: l lines)
  (.setAdjustsFontForContentSizeCategory: l true)
  l)
(def stack (axis spacing)
  (let s (new UIStackView))
  (.setAxis: s axis)
  (.setSpacing: s (itof spacing))
  s)
(def activate (c) (.setActive: c true) c)
(def pin (v p t l b r)
  (.setTranslatesAutoresizingMaskIntoConstraints: v false)
  (activate (.constraintEqualToAnchor:constant: (.topAnchor v) (.topAnchor p) (itof t)))
  (activate (.constraintEqualToAnchor:constant: (.leadingAnchor v) (.leadingAnchor p) (itof l)))
  (activate (.constraintEqualToAnchor:constant: (.bottomAnchor v) (.bottomAnchor p) (itof b)))
  (activate (.constraintEqualToAnchor:constant: (.trailingAnchor v) (.trailingAnchor p) (itof r))))
(def size (v w h)
  (.setTranslatesAutoresizingMaskIntoConstraints: v false)
  (if w (activate (.constraintEqualToConstant: (.widthAnchor v) (itof w))))
  (if h (activate (.constraintEqualToConstant: (.heightAnchor v) (itof h)))))
(def itos (n) (.stringValue (.numberWithLong: NSNumber n)))
(def num (v) (if v (.longValue v) 0))
(def isnull (v) (or (not v) (.isKindOfClass: v NSNull)))
(def sym (n) (.systemImageNamed: UIImage n))
(def action (b) (.actionWithHandler: UIAction b))
(def button (title b)
  (let x (.buttonWithType: UIButton 1))
  (.setTitle:forState: x title 0)
  (.addAction:forControlEvents: x (action b) 8192)
  x)
(def urlq (s) (.stringByAddingPercentEncodingWithAllowedCharacters: s (.URLQueryAllowedCharacterSet NSCharacterSet)))

;; ---- session storage (Keychain)
(cfn SecItemAdd int id id)
(cfn SecItemDelete int id)
(cfn SecItemCopyMatching int id id)
(cfn malloc id long)
(cfn memset id id int long)
(def kquery () (dict "class" "genp" "svce" "thimble" "acct" "s"))
(def savesession (s)
  (set gSession s)
  (SecItemDelete (kquery))
  (if s (SecItemAdd (dict "class" "genp" "svce" "thimble" "acct" "s"
     "v_Data" (.dataWithJSONObject:options:error: NSJSONSerialization s 0 0)) 0)))
(def loadsession ()
  (let box (malloc 8))
  (memset box 0 8)
  (let rc (SecItemCopyMatching (dict "class" "genp" "svce" "thimble" "acct" "s" "r_Data" (.numberWithBool: NSNumber true)) box))
  (if (= rc 0)
    (set gSession (.JSONObjectWithData:options:error: NSJSONSerialization (peek box) 0 0))))

;; ---- XRPC
(def host ()
  (let svc (at gSession "didDoc.service"))
  (if (or (isnull svc) (not (> (.count svc) 0))) (return "https://bsky.social/xrpc/"))
  (str (at (.objectAtIndex: svc 0) "serviceEndpoint") "/xrpc/"))
(def request (verb path body tok)
  (let r (.requestWithURL: NSMutableURLRequest (.URLWithString: NSURL (str (host) path))))
  (.setHTTPMethod: r verb)
  (if tok (.setValue:forHTTPHeaderField: r (str "Bearer " tok) "Authorization"))
  (if (.hasPrefix: path "chat.") (.setValue:forHTTPHeaderField: r "did:web:api.bsky.chat#bsky_chat" "atproto-proxy"))
  (if body (do
    (.setValue:forHTTPHeaderField: r "application/json" "Content-Type")
    (.setHTTPBody: r (.dataWithJSONObject:options:error: NSJSONSerialization body 0 0))))
  r)
(def fetch (r done)
  (.resume (.dataTaskWithRequest:completionHandler: (.sharedSession NSURLSession) r
    (block (data resp err)
      (let j (if data (.JSONObjectWithData:options:error: NSJSONSerialization data 1 0) nil))
      (invoke done j (if resp (.statusCode resp) 0))))))
(def relogin (retry fail)
  (fetch (request "POST" "com.atproto.server.refreshSession" nil (at gSession "refreshJwt"))
    (block (j code)
      (if (= code 200) (do (savesession j) (invoke retry)) (invoke fail nil code)))))
(def xrpc (verb path body done)
  (fetch (request verb path body (at gSession "accessJwt"))
    (block (j code)
      (if (and (= code 400) (.isEqualToString: (at j "error") "ExpiredToken"))
        (relogin (block () (fetch (request verb path body (at gSession "accessJwt")) done)) done)
        (invoke done j code)))))

;; ---- images
(def loadimage (iv url)
  (.setImage: iv nil)
  (ivar! iv "u" url)
  (if (not (isnull url)) (do
    (let hit (.objectForKey: gCache url))
    (if hit (.setImage: iv hit)
      (fetchimg iv url)))))
(def fetchimg (iv url)
  (.resume (.dataTaskWithRequest:completionHandler: (.sharedSession NSURLSession)
    (.requestWithURL: NSMutableURLRequest (.URLWithString: NSURL url))
    (block (data resp err)
      (let img (if data (.imageWithData: UIImage data) nil))
      (if img (do
        (.setObject:forKey: gCache img url)
        (if (.isEqual: (ivar iv "u") url) (.setImage: iv img))))))))
(sig NSObject isEqual: BOOL id)

;; ---- post cell
(def imgview (w h r)
  (let v (new UIImageView))
  (.setContentMode: v 2)
  (.setClipsToBounds: v true)
  (.setCornerRadius: (.layer v) (itof r))
  (.setBackgroundColor: v (.secondarySystemBackgroundColor UIColor))
  (size v w h)
  v)
(def setcount (b n name)
  (.setTitle:forState: b (str " " (itos n)) 0)
  (.setImage:forState: b (sym name) 0))
(class PostCell UITableViewCell ()
  (method initWithStyle:reuseIdentifier: (self st rid)
    (let me (super initWithStyle:reuseIdentifier: self st rid))
    (.setSelectionStyle: me 0)
    (let root (stack 0 10))
    (.setAlignment: root 1)
    (let av (imgview 44 44 22))
    (let col (stack 1 4))
    (let head (label "UICTFontTextStyleSubheadline" (.secondaryLabelColor UIColor) 1))
    (let body (label "UICTFontTextStyleBody" (.labelColor UIColor) 0))
    (let img (imgview 0 220 10))
    (let bar (stack 0 28))
    (let reply (button "0" (block (a) (cellact me "reply"))))
    (let repost (button "0" (block (a) (cellact me "repost"))))
    (let like (button "0" (block (a) (cellact me "like"))))
    (let dots (button "" (block (a) (cellact me "menu"))))
    (.setImage:forState: dots (sym "ellipsis") 0)
    (.setAccessibilityLabel: dots "More")
    (overlay img "Open media" (block (a) (cellact me "media")))
    (overlay av "Open profile" (block (a) (cellact me "profile")))
    (let note (label "UICTFontTextStyleFootnote" (.secondaryLabelColor UIColor) 0))
    (.setAccessibilityLabel: reply "Reply") (.setAccessibilityLabel: repost "Repost") (.setAccessibilityLabel: like "Like")
    (.addArrangedSubview: bar reply)
    (.addArrangedSubview: bar repost)
    (.addArrangedSubview: bar like)
    (.addArrangedSubview: bar (new UIView))
    (.addArrangedSubview: bar dots)
    (.addArrangedSubview: col head)
    (.addArrangedSubview: col body)
    (.addArrangedSubview: col note)
    (.addArrangedSubview: col img)
    (.addArrangedSubview: col bar)
    (.addArrangedSubview: root av)
    (.addArrangedSubview: root col)
    (.addSubview: (.contentView me) root)
    (pin root (.layoutMarginsGuide (.contentView me)) 0 0 0 0)
    (ivar! me "av" av) (ivar! me "head" head) (ivar! me "body" body) (ivar! me "img" img)
    (ivar! me "reply" reply) (ivar! me "repost" repost) (ivar! me "like" like)
    (ivar! me "bar" bar) (ivar! me "note" note)
    me))
(def cellact (cell what)
  (let h (ivar cell "act"))
  (if h (invoke h what)))
(def overlay (v name b)
  (let x (.buttonWithType: UIButton 0))
  (.setAccessibilityLabel: x name)
  (.addAction:forControlEvents: x (action b) 8192)
  (.setUserInteractionEnabled: v true)
  (.addSubview: v x)
  (pin x v 0 0 0 0))
(sig UIView setUserInteractionEnabled: void BOOL)
(def fillcell (c post h)
  (ivar! c "act" h)
  (let a (at post "author"))
  (let dn (at a "displayName"))
  (.setText: (ivar c "head") (str (if (and (not (isnull dn)) (> (.length dn) 0)) dn (at a "handle")) (if (at post "_msg") "" (str "  @" (at a "handle")))))
  (.setAttributedText: (ivar c "body") (richtext post))
  (loadimage (ivar c "av") (at a "avatar"))
  (let m (media post))
  (let warn (and m (and (= (rating post) 1) (not (at post "_reveal")))))
  (.setHidden: (ivar c "img") (or (not m) warn))
  (if (and m (not warn)) (loadimage (ivar c "img") m))
  (.setText: (ivar c "note") (notetext post warn))
  (.setHidden: (ivar c "note") (not (> (.length (.text (ivar c "note"))) 0)))
  (.setHidden: (ivar c "bar") (at post "_plain"))
  (setcount (ivar c "reply") (num (at post "replyCount")) "bubble.left")
  (let v (at post "viewer"))
  (setcount (ivar c "repost") (num (at post "repostCount")) (if (isnull (at v "repost")) "arrow.2.squarepath" "checkmark.circle"))
  (setcount (ivar c "like") (num (at post "likeCount")) (if (isnull (at v "like")) "heart" "heart.fill")))

;; ---- generic feed: "load" block is (cursor done) with done (posts nextcursor)
(class FeedVC UITableViewController ()
  (method viewDidLoad (self)
    (super viewDidLoad self)
    (let t (.tableView self))
    (.registerClass:forCellReuseIdentifier: t PostCell "p")
    (.registerClass:forCellReuseIdentifier: t ProfileCell "h")
    (.setEstimatedRowHeight: t 200.0)
    (let rc (new UIRefreshControl))
    (.addAction:forControlEvents: rc (action (block (a) (reload self))) 4096)
    (.setRefreshControl: t rc)
    (ivar! self "rc" rc)
    (ivar! self "items" (new NSMutableArray))
    (reload self))
  (method tableView:numberOfRowsInSection: (self t s)
    (.count (ivar self "items")))
  (method tableView:cellForRowAtIndexPath: (self t ip)
    (let c (.dequeueReusableCellWithIdentifier:forIndexPath: t "p" ip))
    (let n (.row ip))
    (let items (ivar self "items"))
    (let post (.objectAtIndex: items n))
    (if (> (+ n 6) (.count items)) (more self))
    (if (at post "_profile") (return (profilecell self t ip post)))
    (fillcell c post (block (what) (postaction self post what)))
    c)
  (method tableView:didSelectRowAtIndexPath: (self t ip)
    (.deselectRowAtIndexPath:animated: t ip true)
    (let p (.objectAtIndex: (ivar self "items") (.row ip)))
    (if (or (at p "_profile") (at p "_msg")) (return 0))
    (if (at p "_convo") (return (openconvo self (at p "_convo"))))
    (if (at p "_follow") (return (openprofile self (at p "author.did"))))
    (openthread self p))
  (method searchBarSearchButtonClicked: (self bar)
    (ivar! self "q" (.text bar))
    (.resignFirstResponder bar)
    (reload self)))
(sig UIResponder resignFirstResponder BOOL)
(sig UISearchBar text NSString*)
(sig +NSMutableArray array id)
(def reload (vc)
  (ivar! vc "cursor" nil)
  (ivar! vc "busy" vc)
  (invoke (ivar vc "load") nil (block (posts cur)
    (ivar! vc "busy" nil)
    (.endRefreshing (ivar vc "rc"))
    (let before (.count (ivar vc "items")))
    (.removeAllObjects (ivar vc "items"))
    (if posts (.addObjectsFromArray: (ivar vc "items") posts))
    (ivar! vc "cursor" (if (isnull cur) nil cur))
    (.reloadData (.tableView vc))
    (if (and (ivar vc "bottom") (not (= before (.count (ivar vc "items"))))) (scrollend vc)))))
(sig +NSIndexPath indexPathForRow:inSection: id NSInteger NSInteger)
(sig UITableView scrollToRowAtIndexPath:atScrollPosition:animated: void NSIndexPath* UITableViewScrollPosition BOOL)
(def scrollend (vc)
  (let n (.count (ivar vc "items")))
  (if (> n 0) (.scrollToRowAtIndexPath:atScrollPosition:animated: (.tableView vc) (.indexPathForRow:inSection: NSIndexPath (- n 1) 0) 3 false)))
(def more (vc)
  (if (and (ivar vc "cursor") (not (ivar vc "busy"))) (do
    (ivar! vc "busy" vc)
    (invoke (ivar vc "load") (ivar vc "cursor") (block (posts cur)
      (ivar! vc "busy" nil)
      (if posts (.addObjectsFromArray: (ivar vc "items") posts))
      (ivar! vc "cursor" (if (isnull cur) nil cur))
      (.reloadData (.tableView vc)))))))
(def feedvc (title load)
  (let v (.autorelease (.initWithStyle: (.alloc FeedVC) 0)))
  (.setTitle: v title)
  (ivar! v "load" load)
  v)
(sig UITableViewController initWithStyle: instancetype UITableViewStyle)
(sig +UITableViewController alloc id)

(def strippost (arr)
  ;; timeline items wrap the post in {post: ...}
  (let out (.array NSMutableArray))
  (let i 0)
  (while (< i (.count arr))
    (addpost out (at (.objectAtIndex: arr i) "post"))
    (let i (+ i 1)))
  out)

(def timelinevc ()
  (feedvc "Home" (block (cur done)
    (xrpc "GET" (str "app.bsky.feed.getTimeline?limit=30" (if cur (str "&cursor=" (urlq cur)) "")) nil
      (block (j code)
        (invoke done (if (= code 200) (strippost (at j "feed")) nil) (at j "cursor")))))))

(def collect (node out)
  ;; flattens a thread: parents, the post, then direct replies
  (if (not (isnull node)) (do
    (if (not (isnull (at node "parent"))) (collect (at node "parent") out))
    (if (not (isnull (at node "post"))) (addpost out (at node "post"))))))
(def threadposts (thread)
  (let out (.array NSMutableArray))
  (collect thread out)
  (let rs (at thread "replies"))
  (let i 0)
  (if (not (isnull rs))
    (while (< i (.count rs))
      (let p (at (.objectAtIndex: rs i) "post"))
      (if (not (isnull p)) (addpost out p))
      (let i (+ i 1))))
  out)
(def openthread (from post)
  (let uri (at post "uri"))
  (.pushViewController:animated: (.navigationController from)
    (feedvc "Thread" (block (cur done)
      (xrpc "GET" (str "app.bsky.feed.getPostThread?depth=1&uri=" (urlq uri)) nil
        (block (j code) (invoke done (if (= code 200) (threadposts (at j "thread")) nil) nil)))))
    true))


;; ---- login
(class LoginVC UIViewController ()
  (method viewDidLoad (self)
    (super viewDidLoad self)
    (.setBackgroundColor: (.view self) (.systemBackgroundColor UIColor))
    (let s (stack 1 14))
    (let title (label "UICTFontTextStyleLargeTitle" (.labelColor UIColor) 1))
    (.setText: title "Thimble")
    (let hf (field "Handle" false))
    (let pf (field "App password" true))
    (let err (label "UICTFontTextStyleFootnote" (.systemRedColor UIColor) 0))
    (let go (button "Sign in" (block (a) (signin hf pf err))))
    (.addArrangedSubview: s title)
    (.addArrangedSubview: s hf)
    (.addArrangedSubview: s pf)
    (.addArrangedSubview: s go)
    (.addArrangedSubview: s err)
    (.addSubview: (.view self) s)
    (.setTranslatesAutoresizingMaskIntoConstraints: s false)
    (let g (.layoutMarginsGuide (.view self)))
    (activate (.constraintEqualToAnchor:constant: (.topAnchor s) (.topAnchor (.safeAreaLayoutGuide (.view self))) 40.0))
    (activate (.constraintEqualToAnchor:constant: (.leadingAnchor s) (.leadingAnchor g) 0.0))
    (activate (.constraintEqualToAnchor:constant: (.trailingAnchor s) (.trailingAnchor g) 0.0))))
(def field (ph secure)
  (let f (new UITextField))
  (.setPlaceholder: f ph)
  (.setSecureTextEntry: f secure)
  (.setBorderStyle: f 3)
  (.setAutocapitalizationType: f 0)
  (.setAutocorrectionType: f 1)
  f)
(sig UITextField text NSString*)
(def signin (hf pf err)
  (.setText: err "")
  (fetch (request "POST" "com.atproto.server.createSession"
           (dict "identifier" (.text hf) "password" (.text pf)) nil)
    (block (j code)
      (if (= code 200)
        (do (savesession j) (showmain))
        (.setText: err (if (isnull (at j "message")) "Sign-in failed" (at j "message")))))))

;; ---- root
(def tab (vc title img)
  (let n (.autorelease (.initWithRootViewController: (.alloc UINavigationController) vc)))
  (.setTabBarItem: n (.autorelease (.initWithTitle:image:tag: (.alloc UITabBarItem) title (sym img) 0)))
  n)
(def showmain ()
  (let t (new UITabBarController))
  (let home (timelinevc))
  (.setRightBarButtonItem: (.navigationItem home) (barbtn "square.and.pencil" (block (a) (compose home nil))))
  (let you (profilevc (me)))
  (.setTitle: you "You")
  (.setRightBarButtonItem: (.navigationItem you) (barbtn "rectangle.portrait.and.arrow.right" (block (a) (signout))))
  (.setViewControllers: t (list (tab home "Home" "house") (tab (searchvc) "Search" "magnifyingglass")
    (tab (notifvc) "Alerts" "bell") (tab (convosvc) "Chats" "bubble.left.and.bubble.right") (tab you "You" "person")))
  (.setRootViewController: gWindow t))
(def signout ()
  (savesession nil)
  (set gSession nil)
  (.setRootViewController: gWindow (new LoginVC)))

(class A UIResponder (UIApplicationDelegate UISceneDelegate UIWindowSceneDelegate)
  (method application:configurationForConnectingSceneSession:options: (self app s o)
    (let c (.configurationWithName:sessionRole: UISceneConfiguration nil (.role s)))
    (.setDelegateClass: c A)
    c)
  (method scene:willConnectToSession:options: (self scene s o)
    (set gCache (new NSCache))
    (set gWindow (.initWithWindowScene: (.alloc UIWindow) scene))
    (loadsession)
    (if gSession
      (showmain)
      (.setRootViewController: gWindow (new LoginVC)))
    (.makeKeyAndVisible gWindow)))
