;; Thimble: actions, composer, profiles, moderation, notifications, search, media.
(def me () (at gSession "did"))
(def isodate () (.stringFromDate: (new NSISO8601DateFormatter) (.date NSDate)))
(def createrec (coll rec done)
  (xrpc "POST" "com.atproto.repo.createRecord" (dict "repo" (me) "collection" coll "record" rec) done))
(def delrec (coll uri done)
  (xrpc "POST" "com.atproto.repo.deleteRecord" (dict "repo" (me) "collection" coll "rkey" (.lastPathComponent uri)) done))
(def strongref (post) (dict "uri" (at post "uri") "cid" (at post "cid")))
(def alert (vc title msg)
  (let a (.alertControllerWithTitle:message:preferredStyle: UIAlertController title msg 1))
  (.addAction: a (.actionWithTitle:style:handler: UIAlertAction "OK" 0 nil))
  (.presentViewController:animated:completion: vc a true nil))
(def barbtn (img b)
  (let act (action b))
  (.setImage: act (sym img))
  (.autorelease (.initWithPrimaryAction: (.alloc UIBarButtonItem) act)))
(def nsn (n) (.numberWithLong: NSNumber n))

;; ---- moderation
;; 2 = remove from lists, 1 = cover media and offer "Show media", 0 = allow.
(def labelrating (arr)
  (let out 0)
  (let i 0)
  (if (not (isnull arr))
    (while (< i (.count arr))
      (let v (at (.objectAtIndex: arr i) "val"))
      (if (.isEqualToString: v "!hide") (let out 2))
      (if (and (< out 2) (or (.isEqualToString: v "porn") (or (.isEqualToString: v "sexual") (or (.isEqualToString: v "nudity")
           (or (.isEqualToString: v "graphic-media") (or (.isEqualToString: v "gore") (.isEqualToString: v "!warn")))))))
        (let out 1))
      (let i (+ i 1))))
  out)
(def truthy (v) (and (not (isnull v)) (.boolValue v)))
(def rating (post)
  (let a (labelrating (at post "labels")))
  (let b (labelrating (at post "author.labels")))
  (if (> a b) a b))
(def addpost (out post)
  (if (or (= (rating post) 2)
       (or (truthy (at post "author.viewer.muted")) (or (not (isnull (at post "author.viewer.blocking"))) (truthy (at post "author.viewer.blockedBy")))))
    (return 0))
  (.addObject: out post))

;; ---- post content
(sig NSString substringWithRange: NSString* NSRange)
(def bytelen (s n)
  ;; number of UTF-16 units in the first n UTF-8 bytes
  (.length (.autorelease (.initWithBytes:length:encoding: (.alloc NSString) (.UTF8String s) n 4))))
(def richtext (post)
  (let t (at post "record.text"))
  (if (isnull t) (let t ""))
  (let m (.autorelease (.initWithString: (.alloc NSMutableAttributedString) t)))
  (.addAttribute:value:range: m "NSFont" (font "UICTFontTextStyleBody") 0 (.length t))
  (.addAttribute:value:range: m "NSColor" (.labelColor UIColor) 0 (.length t))
  (let fs (at post "record.facets"))
  (let i 0)
  (if (not (isnull fs))
    (while (< i (.count fs))
      (let f (.objectAtIndex: fs i))
      (let a (bytelen t (.longValue (at f "index.byteStart"))))
      (let b (bytelen t (.longValue (at f "index.byteEnd"))))
      (if (and (< a b) (not (> b (.length t))))
        (.addAttribute:value:range: m "NSColor" (.systemBlueColor UIColor) a (- b a)))
      (let i (+ i 1))))
  m)
(def firstlink (post)
  (let fs (at post "record.facets"))
  (let i 0)
  (if (not (isnull fs))
    (while (< i (.count fs))
      (let u (at (.objectAtIndex: (at (.objectAtIndex: fs i) "features") 0) "uri"))
      (if (not (isnull u)) (return u))
      (let i (+ i 1))))
  (at post "embed.external.uri"))
(def media (post)
  (let imgs (at post "embed.images"))
  (if (and (not (isnull imgs)) (> (.count imgs) 0))
    (return (at (.objectAtIndex: imgs 0) "thumb")))
  (let v (at post "embed.thumbnail"))
  (if (not (isnull v)) (return v))
  (let x (at post "embed.external.thumb"))
  (if (isnull x) nil x))
(def notetext (post warn)
  (let out "")
  (if warn (let out "Sensitive media hidden. Use More to show it.\n"))
  (let imgs (at post "embed.images"))
  (if (and (not (isnull imgs)) (> (.count imgs) 1)) (let out (str out "+" (itos (- (.count imgs) 1)) " more images\n")))
  (if (not (isnull (at post "embed.playlist"))) (let out (str out "▶ Video\n")))
  (let t (at post "embed.external.title"))
  (if (not (isnull t)) (let out (str out "🔗 " t "\n")))
  (let q (at post "embed.record.value.text"))
  (if (not (isnull q)) (let out (str out "❝ " q "\n")))
  out)
(sig UIApplication openURL:options:completionHandler: void NSURL* NSDictionary* id)
(sig +UIApplication sharedApplication id)
(def openurl (u)
  (.openURL:options:completionHandler: (.sharedApplication UIApplication) (.URLWithString: NSURL u) (dict) nil))

;; ---- actions
(def toggle (vc post key countkey coll subject)
  (let cur (at post (str "viewer." key)))
  (if (.isEqual: cur "pending") (return 0))
  (let n (num (at post countkey)))
  (if (isnull cur)
    (do
      (setv post (str "viewer." key) "pending")
      (setv post countkey (nsn (+ n 1)))
      (createrec coll (dict "$type" coll "subject" subject "createdAt" (isodate))
        (block (j code)
          (if (= code 200) (setv post (str "viewer." key) (at j "uri"))
            (do (setv post (str "viewer." key) nil) (setv post countkey (nsn n))))
          (.reloadData (.tableView vc)))))
    (do
      (setv post (str "viewer." key) nil)
      (setv post countkey (nsn (- n 1)))
      (delrec coll cur (block (j code)
        (if (not (= code 200)) (do (setv post (str "viewer." key) cur) (setv post countkey (nsn n))))
        (.reloadData (.tableView vc))))))
  (.reloadData (.tableView vc)))
(def setv (o path v) (.setValue:forKeyPath: o v path))
(sig NSObject setValue:forKeyPath: void id NSString*)
(def postaction (vc post what)
  (if (.isEqualToString: what "like") (toggle vc post "like" "likeCount" "app.bsky.feed.like" (strongref post)))
  (if (.isEqualToString: what "repost") (toggle vc post "repost" "repostCount" "app.bsky.feed.repost" (strongref post)))
  (if (.isEqualToString: what "reply") (compose vc post))
  (if (.isEqualToString: what "profile") (openprofile vc (at post "author.did")))
  (if (.isEqualToString: what "media") (openmedia vc post))
  (if (.isEqualToString: what "menu") (postmenu vc post)))
(def item (a title style b)
  (.addAction: a (.actionWithTitle:style:handler: UIAlertAction title style b)))
(def postmenu (vc post)
  (let a (.alertControllerWithTitle:message:preferredStyle: UIAlertController nil nil 0))
  (let u (firstlink post))
  (if (not (isnull u)) (item a "Open link" 0 (block (x) (openurl u))))
  (if (and (= (rating post) 1) (not (at post "_reveal")))
    (item a "Show media" 0 (block (x) (.setValue:forKey: post (nsn 1) "_reveal") (.reloadData (.tableView vc)))))
  (if (.isEqualToString: (at post "author.did") (me))
    (item a "Delete post" 2 (block (x) (delrec "app.bsky.feed.post" (at post "uri") (block (j code) (reload vc)))))
    (do
      (item a "Report post" 2 (block (x) (reportmenu vc post)))
      (item a "Block account" 2 (block (x) (blockuser vc (at post "author.did"))))))
  (item a "Cancel" 1 nil)
  (.presentViewController:animated:completion: vc a true nil))
(def reportmenu (vc post)
  (let a (.alertControllerWithTitle:message:preferredStyle: UIAlertController "Report post" "Why are you reporting this?" 0))
  (report-option a vc post "Spam" "com.atproto.moderation.defs#reasonSpam")
  (report-option a vc post "Harassment" "com.atproto.moderation.defs#reasonRude")
  (report-option a vc post "Sexual content" "com.atproto.moderation.defs#reasonSexual")
  (report-option a vc post "Illegal content" "com.atproto.moderation.defs#reasonViolation")
  (report-option a vc post "Other" "com.atproto.moderation.defs#reasonOther")
  (item a "Cancel" 1 nil)
  (.presentViewController:animated:completion: vc a true nil))
(def report-option (a vc post title reason)
  (item a title 0 (block (x)
    (xrpc "POST" "com.atproto.moderation.createReport"
      (dict "reasonType" reason "subject" (dict "$type" "com.atproto.repo.strongRef" "uri" (at post "uri") "cid" (at post "cid")))
      (block (j code) (alert vc (if (= code 200) "Report sent" "Report failed") nil))))))
(def blockuser (vc did)
  (createrec "app.bsky.graph.block" (dict "$type" "app.bsky.graph.block" "subject" did "createdAt" (isodate))
    (block (j code) (if (= code 200) (reload vc) (alert vc "Block failed" nil)))))

;; ---- media
(def openmedia (vc post)
  (let p (at post "embed.playlist"))
  (if (not (isnull p))
    (do
      (let v (new AVPlayerViewController))
      (let pl (.playerWithURL: AVPlayer (.URLWithString: NSURL p)))
      (.setPlayer: v pl)
      (.presentViewController:animated:completion: vc v true (block () (.play pl))))
    (do
      (let imgs (at post "embed.images"))
      (if (and (not (isnull imgs)) (> (.count imgs) 0))
        (.pushViewController:animated: (.navigationController vc) (imagevc (at (.objectAtIndex: imgs 0) "fullsize") (at (.objectAtIndex: imgs 0) "alt")) true)))))
(def imagevc (url alt)
  (let v (new UIViewController))
  (.setBackgroundColor: (.view v) (.systemBackgroundColor UIColor))
  (let i (new UIImageView))
  (.setContentMode: i 1)
  (if (not (isnull alt)) (.setAccessibilityLabel: i alt))
  (.addSubview: (.view v) i)
  (pin i (.safeAreaLayoutGuide (.view v)) 0 0 0 0)
  (loadimage i url)
  v)

;; ---- composer
(class ComposeVC UIViewController ()
  (method viewDidLoad (self)
    (super viewDidLoad self)
    (.setBackgroundColor: (.view self) (.systemBackgroundColor UIColor))
    (.setTitle: self (if (ivar self "parent") "Reply" "New post"))
    (let tv (new UITextView))
    (.setFont: tv (font "UICTFontTextStyleBody"))
    (.setAccessibilityLabel: tv "Post text")
    (let s (stack 1 8))
    (let alt (field "Image description" false))
    (.setHidden: alt true)
    (let photo (button "Add photo" (block (a) (pickphoto self))))
    (.addArrangedSubview: s tv)
    (.addArrangedSubview: s alt)
    (.addArrangedSubview: s photo)
    (.addSubview: (.view self) s)
    (.setTranslatesAutoresizingMaskIntoConstraints: s false)
    (let g (.keyboardLayoutGuide (.view self)))
    (let m (.layoutMarginsGuide (.view self)))
    (activate (.constraintEqualToAnchor:constant: (.topAnchor s) (.topAnchor (.safeAreaLayoutGuide (.view self))) 8.0))
    (activate (.constraintEqualToAnchor:constant: (.leadingAnchor s) (.leadingAnchor m) 0.0))
    (activate (.constraintEqualToAnchor:constant: (.trailingAnchor s) (.trailingAnchor m) 0.0))
    (activate (.constraintEqualToAnchor:constant: (.bottomAnchor s) (.topAnchor g) -8.0))
    (ivar! self "tv" tv) (ivar! self "altf" alt)
    (.setLeftBarButtonItem: (.navigationItem self) (barbtn "xmark" (block (a) (.dismissViewControllerAnimated:completion: self true nil))))
    (.setRightBarButtonItem: (.navigationItem self) (barbtn "paperplane" (block (a) (submit self))))
    (.becomeFirstResponder tv))
  (method attach: (self img)
    (ivar! self "img" img)
    (.setHidden: (ivar self "altf") false))
  (method picker:didFinishPicking: (self p results)
    (.dismissViewControllerAnimated:completion: p true nil)
    (if (> (.count results) 0)
      (.loadObjectOfClass:completionHandler: (.itemProvider (.objectAtIndex: results 0)) UIImage
        (block (img err) (if img (attach-image self img)))))))
(sig UIView keyboardLayoutGuide id)
(def attach-image (vc img) (ivar! vc "img" img) (.setHidden: (ivar vc "altf") false))
(sig UITextView text NSString*)
(def pickphoto (vc)
  (let c (.init (.alloc PHPickerConfiguration)))
  (.setSelectionLimit: c 1)
  (.setFilter: c (.imagesFilter PHPickerFilter))
  (let p (.initWithConfiguration: (.alloc PHPickerViewController) c))
  (.setDelegate: p vc)
  (.presentViewController:animated:completion: vc p true nil))
(def compose (from parent)
  (let v (new ComposeVC))
  (ivar! v "parent" parent)
  (ivar! v "from" from)
  (let n (.autorelease (.initWithRootViewController: (.alloc UINavigationController) v)))
  (.presentViewController:animated:completion: from n true nil))
(cfn UIImageJPEGRepresentation id id double)
(def blobreq (data)
  (let r (.requestWithURL: NSMutableURLRequest (.URLWithString: NSURL (str (host) "com.atproto.repo.uploadBlob"))))
  (.setHTTPMethod: r "POST")
  (authorize r "POST" (str (host) "com.atproto.repo.uploadBlob") (at gSession "accessJwt"))
  (.setValue:forHTTPHeaderField: r "image/jpeg" "Content-Type")
  (.setHTTPBody: r data)
  r)
(def submit (vc)
  (let text (.text (ivar vc "tv")))
  (if (not (> (.length text) 0)) (return 0))
  (let img (ivar vc "img"))
  (if img
    (fetch (blobreq (UIImageJPEGRepresentation (.imageByPreparingThumbnailOfSize: img 1600.0 1600.0) 0.75))
      (block (j code)
        (if (= code 200)
          (publish vc text (dict "$type" "app.bsky.embed.images"
            "images" (list (dict "image" (at j "blob") "alt" (.text (ivar vc "altf"))))))
          (alert vc "Upload failed" nil))))
    (publish vc text nil)))
(def publish (vc text embed)
  (let parent (ivar vc "parent"))
  (let reply nil)
  (if parent (do
    (let root (at parent "record.reply.root"))
    (let reply (dict "root" (if (isnull root) (strongref parent) root) "parent" (strongref parent)))))
  (createrec "app.bsky.feed.post"
    (dict "$type" "app.bsky.feed.post" "text" text "createdAt" (isodate) "reply" reply "embed" embed)
    (block (j code)
      (if (= code 200)
        (do
          (let from (ivar vc "from"))
          (.dismissViewControllerAnimated:completion: vc true nil)
          (reload from))
        (alert vc "Could not post" (at j "message"))))))

;; ---- profiles
(class ProfileCell UITableViewCell ()
  (method initWithStyle:reuseIdentifier: (self st rid)
    (let me (super initWithStyle:reuseIdentifier: self st rid))
    (.setSelectionStyle: me 0)
    (let s (stack 1 6))
    (let av (imgview 72 72 36))
    (let name (label "UICTFontTextStyleTitle2" (.labelColor UIColor) 1))
    (let bio (label "UICTFontTextStyleBody" (.labelColor UIColor) 0))
    (let counts (label "UICTFontTextStyleFootnote" (.secondaryLabelColor UIColor) 1))
    (let row (stack 0 16))
    (let f (button "Follow" (block (a) (invoke (ivar me "act") "follow"))))
    (let b (button "Block" (block (a) (invoke (ivar me "act") "block"))))
    (let msg (button "Message" (block (a) (invoke (ivar me "act") "message"))))
    (ivar! me "m" msg)
    (.addArrangedSubview: row f) (.addArrangedSubview: row msg) (.addArrangedSubview: row b) (.addArrangedSubview: row (new UIView))
    (.addArrangedSubview: s av) (.addArrangedSubview: s name) (.addArrangedSubview: s bio) (.addArrangedSubview: s counts) (.addArrangedSubview: s row)
    (.setAlignment: s 1)
    (.addSubview: (.contentView me) s)
    (pin s (.layoutMarginsGuide (.contentView me)) 0 0 0 0)
    (ivar! me "av" av) (ivar! me "name" name) (ivar! me "bio" bio) (ivar! me "counts" counts) (ivar! me "f" f) (ivar! me "b" b)
    me))
(def profilecell (vc t ip p)
  (let c (.dequeueReusableCellWithIdentifier:forIndexPath: t "h" ip))
  (loadimage (ivar c "av") (at p "avatar"))
  (let dn (at p "displayName"))
  (.setText: (ivar c "name") (if (or (isnull dn) (not (> (.length dn) 0))) (at p "handle") dn))
  (.setText: (ivar c "bio") (if (isnull (at p "description")) "" (at p "description")))
  (.setText: (ivar c "counts") (str (itos (num (at p "followersCount"))) " followers · " (itos (num (at p "followsCount"))) " following · " (itos (num (at p "postsCount"))) " posts"))
  (let mine (.isEqualToString: (at p "did") (me)))
  (.setHidden: (ivar c "f") mine) (.setHidden: (ivar c "b") mine) (.setHidden: (ivar c "m") mine)
  (.setTitle:forState: (ivar c "f") (if (isnull (at p "viewer.following")) "Follow" "Unfollow") 0)
  (.setTitle:forState: (ivar c "b") (if (isnull (at p "viewer.blocking")) "Block" "Unblock") 0)
  (ivar! c "act" (block (what) (profileact vc p what)))
  c)
(def profileact (vc p what)
  (if (.isEqualToString: what "message") (return (openchat vc (at p "did"))))
  (let isf (.isEqualToString: what "follow"))
  (let key (if isf "viewer.following" "viewer.blocking"))
  (let coll (if isf "app.bsky.graph.follow" "app.bsky.graph.block"))
  (let cur (at p key))
  (if (isnull cur)
    (createrec coll (dict "$type" coll "subject" (at p "did") "createdAt" (isodate))
      (block (j code) (if (= code 200) (reload vc) (alert vc "Failed" nil))))
    (delrec coll cur (block (j code) (reload vc)))))
(def profilevc (actor)
  (feedvc "Profile" (block (cur done)
    (let path (str "app.bsky.feed.getAuthorFeed?limit=30&actor=" (urlq actor) (if cur (str "&cursor=" (urlq cur)) "")))
    (if cur
      (xrpc "GET" path nil (block (j code) (invoke done (if (= code 200) (strippost (at j "feed")) nil) (at j "cursor"))))
      (xrpc "GET" (str "app.bsky.actor.getProfile?actor=" (urlq actor)) nil
        (block (pj pcode)
          (xrpc "GET" path nil (block (j code)
            (let out (.array NSMutableArray))
            (if (= pcode 200) (do (.setValue:forKey: pj (nsn 1) "_profile") (.addObject: out pj)))
            (if (= code 200) (.addObjectsFromArray: out (strippost (at j "feed"))))
            (invoke done out (at j "cursor"))))))))))
(def openprofile (vc did)
  (.pushViewController:animated: (.navigationController vc) (profilevc did) true))

;; ---- notifications
(def reasontext (r)
  (if (.isEqualToString: r "like") (return "liked your post"))
  (if (.isEqualToString: r "repost") (return "reposted your post"))
  (if (.isEqualToString: r "follow") (return "followed you"))
  (if (.isEqualToString: r "reply") (return "replied to you"))
  (if (.isEqualToString: r "mention") (return "mentioned you"))
  (if (.isEqualToString: r "quote") (return "quoted your post"))
  r)
(def notifpost (n)
  (let reason (at n "reason"))
  (let subj (at n "reasonSubject"))
  (let text (at n "record.text"))
  (let body (reasontext reason))
  (if (not (isnull text)) (let body (str body ": " text)))
  (let m (dict "text" body))
  (dict "author" (at n "author") "record" m "_plain" (nsn 1)
    "uri" (if (or (isnull subj) (.isEqualToString: reason "reply") (.isEqualToString: reason "mention")) (at n "uri") subj)
    "_follow" (if (.isEqualToString: reason "follow") (nsn 1) nil)))
(def notifvc ()
  (feedvc "Alerts" (block (cur done)
    (xrpc "GET" (str "app.bsky.notification.listNotifications?limit=40" (if cur (str "&cursor=" (urlq cur)) "")) nil
      (block (j code)
        (let out (.array NSMutableArray))
        (let arr (at j "notifications"))
        (let i 0)
        (if (and (= code 200) (not (isnull arr)))
          (while (< i (.count arr))
            (.addObject: out (notifpost (.objectAtIndex: arr i)))
            (let i (+ i 1))))
        (invoke done out (at j "cursor")))))))

;; ---- search
(def searchvc ()
  (let v 0)
  (let box (new NSMutableArray))
  (let v (feedvc "Search" (block (cur done)
    (let me2 (.objectAtIndex: box 0))
    (let q (ivar me2 "q"))
    (if (not q) (return (invoke done (.array NSMutableArray) nil)))
    (xrpc "GET" (str "app.bsky.feed.searchPosts?limit=30&q=" (urlq q) (if cur (str "&cursor=" (urlq cur)) "")) nil
      (block (j code)
        (let out (.array NSMutableArray))
        (let arr (at j "posts"))
        (let i 0)
        (if (and (= code 200) (not (isnull arr)))
          (while (< i (.count arr)) (addpost out (.objectAtIndex: arr i)) (let i (+ i 1))))
        (invoke done out (at j "cursor")))))))
  (.addObject: box v)
  (let sc (.autorelease (.initWithSearchResultsController: (.alloc UISearchController) nil)))
  (.setObscuresBackgroundDuringPresentation: sc false)
  (.setDelegate: (.searchBar sc) v)
  (.setSearchController: (.navigationItem v) sc)
  (.setHidesSearchBarWhenScrolling: (.navigationItem v) false)
  v)
;; ---- direct messages (not end-to-end encrypted)
(def peer (convo)
  (let ms (at convo "members"))
  (let i 0)
  (while (< i (.count ms))
    (let m (.objectAtIndex: ms i))
    (if (not (.isEqualToString: (at m "did") (me))) (return m))
    (let i (+ i 1)))
  (.objectAtIndex: ms 0))
(def convosvc ()
  (feedvc "Chats" (block (cur done)
    (xrpc "GET" "chat.bsky.convo.listConvos?limit=40" nil
      (block (j code)
        (let out (.array NSMutableArray))
        (let arr (at j "convos"))
        (let i 0)
        (if (and (= code 200) (not (isnull arr)))
          (while (< i (.count arr))
            (let c (.objectAtIndex: arr i))
            (let last (at c "lastMessage.text"))
            (.addObject: out (dict "author" (peer c) "_plain" (nsn 1) "_convo" c
              "record" (dict "text" (if (isnull last) "No messages yet" last))))
            (let i (+ i 1))))
        (invoke done out nil))))))
(def openchat (vc did)
  (xrpc "GET" (str "chat.bsky.convo.getConvoForMembers?members=" (urlq did)) nil
    (block (j code)
      (if (= code 200) (openconvo vc (at j "convo")) (alert vc "Chat unavailable" (at j "message"))))))
(sig UIView initWithFrame: instancetype CGRect)
(sig UIView setAutoresizingMask: void UIViewAutoresizing)
(sig +NSTimer scheduledTimerWithTimeInterval:repeats:block: id double BOOL id)
(sig NSTimer invalidate void)
(sig UIViewController viewDidAppear: void BOOL)
(sig UIViewController viewWillDisappear: void BOOL)
(sig UITextField setText: void NSString*)
(sig UITextField setDelegate: void id)
(class ChatVC FeedVC ()
  (method canBecomeFirstResponder (self) true)
  (method inputAccessoryView (self) (ivar self "bar"))
  (method viewDidAppear: (self a)
    (super viewDidAppear: self a)
    (.becomeFirstResponder self)
    (ivar! self "timer" (.scheduledTimerWithTimeInterval:repeats:block: NSTimer 5.0 true (block (t) (reload self)))))
  (method viewWillDisappear: (self a)
    (super viewWillDisappear: self a)
    (.invalidate (ivar self "timer"))))
(def openconvo (vc convo)
  (let v (.autorelease (.initWithStyle: (.alloc ChatVC) 0)))
  (let id2 (at convo "id"))
  (let p (peer convo))
  (.setTitle: v (at p "handle"))
  (ivar! v "bottom" v)
  (ivar! v "load" (block (cur done)
    (xrpc "GET" (str "chat.bsky.convo.getMessages?limit=60&convoId=" (urlq id2)) nil
      (block (j code)
        (let out (.array NSMutableArray))
        (let arr (at j "messages"))
        (let i (if (isnull arr) 0 (.count arr)))
        (while (> i 0)
          (let i (- i 1))
          (let m (.objectAtIndex: arr i))
          (if (not (isnull (at m "text")))
            (.addObject: out (dict "_plain" (nsn 1) "_msg" (nsn 1) "record" (dict "text" (at m "text"))
              "author" (if (.isEqualToString: (at m "sender.did") (me)) (dict "handle" "You") p)))))
        (invoke done out nil)))))
  (let bar (.autorelease (.initWithFrame: (.alloc UIView) 0.0 0.0 390.0 56.0)))
  (.setAutoresizingMask: bar 2)
  (.setBackgroundColor: bar (.systemBackgroundColor UIColor))
  (let s (stack 0 8))
  (let f (field "Message" false))
  (let go (button "Send" (block (a) (sendmsg v id2 f))))
  (.addArrangedSubview: s f)
  (.addArrangedSubview: s go)
  (.addSubview: bar s)
  (pin s (.layoutMarginsGuide bar) 0 0 0 0)
  (ivar! v "bar" bar)
  (.pushViewController:animated: (.navigationController vc) v true))
(def sendmsg (vc id2 f)
  (let t (.text f))
  (if (not (> (.length t) 0)) (return 0))
  (.setText: f "")
  (xrpc "POST" "chat.bsky.convo.sendMessage" (dict "convoId" id2 "message" (dict "text" t))
    (block (j code)
      (if (= code 200) (reload vc) (alert vc "Could not send" (at j "message"))))))
