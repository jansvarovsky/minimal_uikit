(class A UIResponder (UIApplicationDelegate UISceneDelegate UIWindowSceneDelegate)
  (method application:configurationForConnectingSceneSession:options: (self app s o)
    (let c (.configurationWithName:sessionRole: UISceneConfiguration nil (.role s)))
    (.setDelegateClass: c A)
    c)
  (method scene:willConnectToSession:options: (self scene s o)
    (let w (.initWithWindowScene: (.alloc UIWindow) scene))
    (.setRootViewController: w (new UIViewController))
    (.makeKeyAndVisible w)))
